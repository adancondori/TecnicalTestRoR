<div class="row justify-content-center py-4">
  <div class="col-11 col-sm-8 col-md-6 col-lg-5 col-xl-4">
    <div class="text-center mb-4">
      <div class="d-inline-flex align-items-center justify-content-center bg-warning rounded-circle" style="width: 72px; height: 72px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="white" viewBox="0 0 16 16">
          <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
        </svg>
      </div>
    </div>
    <div class="card shadow-sm border-0">
      <div class="card-body p-4 text-center">
        <h5 class="card-title text-warning mb-2">Challenge Already Processed</h5>
        <p class="text-muted mb-3">This 3D Secure challenge has already been completed.</p>
        <% if @existing %>
          <div class="bg-light rounded p-2">
            <small class="text-muted">
              Status: <strong><%= @existing.status %></strong>
              &mdash; <%= @existing.updated_at.strftime("%Y-%m-%d %H:%M:%S UTC") %>
            </small>
          </div>
        <% end %>
      </div>
    </div>
    <p class="text-center text-muted mt-3 small">You may close this window.</p>
  </div>
</div>
