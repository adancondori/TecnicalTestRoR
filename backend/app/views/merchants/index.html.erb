<div class="py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Merchants</h2>
    <%= link_to "New Merchant", new_merchant_path, class: "btn btn-primary" %>
  </div>

  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Business Name</th>
            <th>Status</th>
            <th>API Key</th>
            <th>Transactions</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @merchants.each do |merchant| %>
            <tr>
              <td class="fw-bold"><%= merchant.business_name %></td>
              <td><%= status_badge(merchant.status) %></td>
              <td><code class="small"><%= merchant.api_key %></code></td>
              <td><%= merchant.payment_requests.count %></td>
              <td><small class="text-muted"><%= merchant.created_at.strftime("%Y-%m-%d") %></small></td>
              <td>
                <%= link_to "View", merchant_path(merchant), class: "btn btn-sm btn-outline-primary" %>
                <%= link_to "Edit", edit_merchant_path(merchant), class: "btn btn-sm btn-outline-secondary" %>
                <%= link_to "Delete", merchant_path(merchant), method: :delete,
                      data: { confirm: "Are you sure you want to delete #{merchant.business_name}?" },
                      class: "btn btn-sm btn-outline-danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
