        {
          "name": "Capture Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.test('Payment captured', function() {",
                  "        pm.expect(jsonData.data.status).to.eql('SUCCEEDED');",
                  "        pm.expect(jsonData.data.captured_amount).to.be.above(0);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 25000\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/payment_requests/{{payment_request_id}}/capture",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payment_requests", "{{payment_request_id}}", "capture"]
            },
            "description": "Captures a previously AUTHORIZED payment. Only works for payments with capture_method=MANUAL and status=AUTHORIZED.\n\n**Flow**: First create a payment with `capture_method: MANUAL`, then capture it.\n\nOptionally specify a partial `amount` (must be <= authorized amount). Omit amount to capture full authorization."
