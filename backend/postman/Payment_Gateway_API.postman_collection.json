    {
      "name": "Payment Requests",
      "description": "Create and manage payment requests (charges). Supports card, e-wallet, and QR code payments with auto or manual capture.",
      "item": [
        {
          "name": "Create Payment (Card - Auto Capture)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('payment_request_id', jsonData.data.id);",
                  "    pm.test('Payment succeeded with auto-capture', function() {",
                  "        pm.expect(jsonData.data.id).to.match(/^pr-/);",
                  "        pm.expect(jsonData.data.status).to.eql('SUCCEEDED');",
                  "        pm.expect(jsonData.data.captured_amount).to.eql(50000);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-ID",
                "value": "{{$guid}}",
                "description": "Idempotency key"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference_id\": \"order-{{$timestamp}}\",\n  \"amount\": 50000,\n  \"currency\": \"USD\",\n  \"capture_method\": \"AUTOMATIC\",\n  \"description\": \"Test auto-capture payment\",\n  \"card\": {\n    \"card_number\": \"4000000000001000\",\n    \"expiry_month\": \"12\",\n    \"expiry_year\": \"2028\",\n    \"cvv\": \"123\",\n    \"cardholder_name\": \"John Doe\"\n  },\n  \"metadata\": {\n    \"order_id\": \"12345\",\n    \"customer_email\": \"john@example.com\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/payment_requests",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payment_requests"]
            },
            "description": "Creates a payment with inline card tokenization and automatic capture. The payment goes directly to SUCCEEDED status.\n\nAmount is in cents: 50000 = $500.00"
          },
          "response": []
        },
