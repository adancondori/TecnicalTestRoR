# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# ========================
# Environment & Secrets
# ========================
.env
.env.*
!.env.example
!.env.sample
/config/master.key
/config/application.yml

# ========================
# Ruby / Rails
# ========================
/.bundle
/vendor/bundle
backend/.bundle
backend/vendor/bundle

# SQLite databases
/db/*.sqlite3
/db/*.sqlite3-*
backend/db/*.sqlite3
backend/db/*.sqlite3-*

# Logs and temp files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
backend/log/*
backend/tmp/*
!backend/log/.keep
!backend/tmp/.keep

# Pidfiles
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Storage (Active Storage uploads in development)
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
backend/storage/*
!backend/storage/.keep

# Spring (Rails preloader)
/tmp/restart.txt
spring/*.pid

# Coverage reports
coverage/

# ========================
# Node.js / Frontend
# ========================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.cache/

# Vite
*.local

# ========================
# Docker
# ========================
docker-compose.override.yml

# ========================
# OS files
# ========================
.DS_Store
Thumbs.db

# ========================
# IDEs & Editors
# ========================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ========================
# Misc
# ========================
*.pid
*.seed
*.log
